# ============================================
# Portal Cybhor Tech v2 - Variáveis do docker-compose
# ============================================
# Copie para `.env` na raiz do projeto e ajuste os valores antes
# de rodar `docker compose up -d --build`. NUNCA commite o `.env`.

# --- PostgreSQL ---
POSTGRES_USER=cybhor
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=cybhor_portal

# --- Autenticação (JWT em cookie httpOnly) ---
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=7d
# true em produção (HTTPS obrigatório para cookies "Secure")
COOKIE_SECURE=false

# --- CORS: origem pública do frontend ---
CORS_ORIGIN=http://localhost:8080

# --- Armazenamento (MinIO local, compatível com S3) ---
MINIO_ROOT_USER=cybhor_minio_admin
MINIO_ROOT_PASSWORD=troque_por_uma_senha_forte
S3_BUCKET=portalcybhor
# Deixe vazio para servir arquivos via http://SEU_DOMINIO:9000/portalcybhor
# Ou aponte para um domínio/proxy reverso próprio na frente do MinIO
S3_PUBLIC_BASE_URL=
