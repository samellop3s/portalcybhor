# ============================================
# Portal Cybhor Tech - Backend Environment
# ============================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env.

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origem(ns) do frontend autorizada(s) a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5500,http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql://cybhor:cybhor_password@localhost:5432/cybhor_portal
PGSSL=false

# --- Autenticação (JWT em cookie httpOnly) ---
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# --- Armazenamento de arquivos (S3-compatible: AWS S3, Cloudflare R2, MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portalcybhor
S3_ACCESS_KEY_ID=cybhor_minio_admin
S3_SECRET_ACCESS_KEY=troque_por_uma_senha_forte
S3_FORCE_PATH_STYLE=true
# URL pública para servir arquivos (deixe vazio para usar URLs assinadas temporárias)
S3_PUBLIC_BASE_URL=
